<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette: white cards on a faint grey canvas, Windows blue as the only saturated colour. -->
    <Color x:Key="Color.Window">#FFF7F8FA</Color>
    <Color x:Key="Color.Card">#FFFFFFFF</Color>
    <Color x:Key="Color.CardBorder">#FFE4E6EA</Color>
    <Color x:Key="Color.CardBorderHover">#FFC9CED6</Color>
    <Color x:Key="Color.TextPrimary">#FF15181E</Color>
    <Color x:Key="Color.TextSecondary">#FF5C6672</Color>
    <Color x:Key="Color.TextTertiary">#FF8A93A0</Color>
    <Color x:Key="Color.Accent">#FF0F6CBD</Color>
    <Color x:Key="Color.AccentHover">#FF0A5FA8</Color>
    <Color x:Key="Color.AccentText">#FFFFFFFF</Color>
    <Color x:Key="Color.Selected">#FFEAF2FB</Color>
    <Color x:Key="Color.SelectedBorder">#FF8FBEE6</Color>
    <Color x:Key="Color.Hover">#FFF2F4F7</Color>
    <Color x:Key="Color.Badge">#FFEDF0F4</Color>
    <Color x:Key="Color.BadgeText">#FF4C5560</Color>
    <Color x:Key="Color.Success">#FF1E7A3C</Color>
    <Color x:Key="Color.SuccessBg">#FFE6F4EA</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="{StaticResource Color.CardBorder}" />
    <SolidColorBrush x:Key="Brush.CardBorderHover" Color="{StaticResource Color.CardBorderHover}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Color.Selected}" />
    <SolidColorBrush x:Key="Brush.SelectedBorder" Color="{StaticResource Color.SelectedBorder}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Badge" Color="{StaticResource Color.Badge}" />
    <SolidColorBrush x:Key="Brush.BadgeText" Color="{StaticResource Color.BadgeText}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessBg" Color="{StaticResource Color.SuccessBg}" />

</ResourceDictionary>
