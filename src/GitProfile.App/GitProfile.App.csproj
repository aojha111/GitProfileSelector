<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>GitProfile.App</RootNamespace>
    <AssemblyName>GitProfile</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon, which WPF does not provide. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- That icon is the only Windows Forms code here, and WPF - not Application.SetHighDpiMode - owns DPI. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The exe, title bar and tray all show this one glyph. -->
    <ApplicationIcon>GitProfile.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>GitProfile</Product>
    <Description>Pick which GitHub account git pushes as, so Git Credential Manager stops asking.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitProfile.Core\GitProfile.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack resource, so the window and the tray can load the same file the exe icon uses. -->
    <Resource Include="GitProfile.ico" />
  </ItemGroup>

</Project>
